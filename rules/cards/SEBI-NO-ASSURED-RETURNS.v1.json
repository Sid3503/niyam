  "id": "SEBI-NO-ASSURED-RETURNS",
  "title": "No promise of assured or risk-free returns (SEBI advisers)",
  "obligation": "A SEBI-registered investment adviser must not make any promise or guarantee of assured or risk-free return in advertisements, and must not hold out advice implying assured, minimum or target returns, or percentage accuracy, in service to clients.",
  "source": {
    "regulator": "SEBI",
    "document": "Master Circular for Investment Advisers",
    "reference": "SEBI Master Circular (IA)",
    "issue_date": "2026-02-06",
    "document_status": "in_force",
    "file": "regulations/sebi/SEBI_2026-02-06_master-circular-investment-advisers.pdf",
    "sha256": "ab1d6f24e184cc2766052b9c3a0fc28ee237b9c2e02fae8d5129f5dd1970cdce",
    "text_basis": "native",
    "provenance": "official",
    "locator": "advertisement code para 10.1(c)(x) (agent-reported number); service-to-client prohibition (Annexure A, agent-reported)",
    "quotes": [
      "Any promise or guarantee of assured or risk free return to the investors.",
      "Investment Adviser shall not, in the course of performing its services to the client, hold out any investment advice implying any assured returns or minimum returns or target return or percentage accuracy"
    ],
    "url": "sebi.gov.in master circular PDF"
  },
  "check": {
