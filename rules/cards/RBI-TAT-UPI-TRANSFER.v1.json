  "id": "RBI-TAT-UPI-TRANSFER",
  "title": "UPI transfer not credited: beneficiary bank reverses by T+1",
  "obligation": "Where a UPI account is debited but the beneficiary account is not credited (transfer of funds), the beneficiary bank must auto-reverse by T+1, and ₹100 per day is payable for delay beyond T+1. A customer-facing agent must not give a later deadline or omit the compensation.",
  "source": {
    "regulator": "RBI",
    "document": "Harmonisation of Turn Around Time (TAT) and customer compensation for failed transactions using authorised Payment Systems",
    "reference": "DPSS.CO.PD No.629/02.01.014/2019-20",
    "issue_date": "2019-09-20",
    "document_status": "in_force",
    "file": "regulations/rbi-payments/RBI_2019-09-20_tat-failed-transactions-dpss629.html",
    "sha256": "a411ba531e2bdbb55b85ce15d613e4cb6c105912df82d7bd8cb3ec47446bd64b",
    "text_basis": "native",
    "provenance": "official_html_extract",
    "locator": "Annex, UPI row 4a; general instruction 4",
    "quotes": [
      "Unified Payments Interface (UPI) a Account debited but the beneficiary account is not credited (transfer of funds). If unable to credit the beneficiary account, auto reversal (R) by the Beneficiary bank latest on T + 1 day. ₹100/- per day if delay is beyond T + 1 day.",
      "T is the day of transaction and refers to the calendar date."
    ],
    "url": "https://www.rbi.org.in/ (page text extract; rbidocs PDF blocked)"
  },
