  "id": "RBI-TAT-COMP-100",
  "title": "Failed-transaction compensation is automatic, per day of delay",
  "obligation": "Where a failed transaction is not resolved within its row's TAT, financial compensation of ₹100 per day of delay must be credited to the customer's account suo moto, without waiting for a complaint or claim. An agent must not describe compensation as discretionary or require the customer to claim it.",
  "source": {
    "regulator": "RBI",
    "document": "Harmonisation of Turn Around Time (TAT) and customer compensation for failed transactions using authorised Payment Systems",
    "reference": "DPSS.CO.PD No.629/02.01.014/2019-20",
    "issue_date": "2019-09-20",
    "document_status": "in_force",
    "file": "regulations/rbi-payments/RBI_2019-09-20_tat-failed-transactions-dpss629.html",
    "sha256": "a411ba531e2bdbb55b85ce15d613e4cb6c105912df82d7bd8cb3ec47446bd64b",
    "text_basis": "native",
    "provenance": "official_html_extract",
    "locator": "paras 4 and 5; Annex compensation column",
    "quotes": [
      "the prescribed TAT is the outer limit for resolution of failed transactions",
      "Wherever financial compensation is involved, the same shall be effected to the customer’s account suo moto, without waiting for a complaint or claim from the customer."
    ],
    "url": "https://www.rbi.org.in/ (page text extract; rbidocs PDF blocked)"
  },
