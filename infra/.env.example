# Copy to infra/.env (git-ignored) and fill in. Nothing here is a real secret.
POSTGRES_PASSWORD=change-me
NIYAM_ENV=dev
# Set to require X-API-Key on /api/*. Leave empty only for local dev.
NIYAM_API_KEY=
# Store pasted check text in the DB? true for synthetic/demo data only.
NIYAM_STORE_CHECK_TEXT=true
# Pin "today" for reproducible demos/tests (ISO date), or leave empty.
NIYAM_AS_OF_OVERRIDE=
# Sarvam (Tier B judge / rewrite). Empty = LLM features off; Tier B abstains to "review".
SARVAM_API_KEY=
# Ollama cloud (alternative LLM provider; auto-preferred when set because it was faster in our benchmark)
OLLAMA_API_KEY=
# gpt-oss:120b | gpt-oss:20b | nemotron-3-nano:30b | nemotron-3-ultra | beam all passed our 5-case judge check; gemma4:31b did not
NIYAM_OLLAMA_MODEL=gpt-oss:120b
# auto | ollama | sarvam
NIYAM_LLM_PROVIDER=auto
API_PORT=8000
WEB_PORT=8080
DB_PORT=5433
INSTALL_DEV=1
